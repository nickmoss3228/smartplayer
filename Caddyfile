# METRICS — metrics.малако.рф -> metrics.xn--80aa4acdq.xn--p1ai
#
# COMMENTED OUT DELIBERATELY. Read the block at the top of this file before
# enabling: Caddy requests a certificate on startup for every name listed here,
# and five failed HTTP-01 challenges burn the Let's Encrypt rate limit for that
# hostname for an hour. Uncomment ONLY after
#
#     dig +short metrics.xn--80aa4acdq.xn--p1ai
#
# returns 89.169.159.92. Until then Grafana is still reachable for a quick look
# over an SSH tunnel, with no DNS and no certificate involved:
#
#     ssh -N -L 3001:localhost:3000 smartplayer
#     # then open http://localhost:3001
#
# (That works because grafana publishes 127.0.0.1:3000 on the VM — loopback
# only, so it is reachable through an SSH session on the box but not from the
# internet. Note `expose:` alone is NOT enough for a tunnel: nothing would be
# listening on the host and the forward would land on a closed port.)
#
# The same cookie gate as staging is applied on purpose. Grafana has its own
# login, but the gate means an unauthenticated scanner sees a bare 404 instead
# of a Grafana login page advertising the version it could look up a CVE for.
# It reuses STAGING_GATE_SECRET, so one unlock covers both hosts.
#
# metrics.xn--80aa4acdq.xn--p1ai {
# 	log {
# 		output stdout
# 		format json {
# 			time_format rfc3339_nano
# 		}
# 	}
#
# 	header X-Robots-Tag "noindex, nofollow"
#
# 	@unlock path /__unlock/{$STAGING_GATE_SECRET}
# 	handle @unlock {
# 		header Set-Cookie "stg={$STAGING_GATE_SECRET}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax"
# 		redir * / 302
# 	}
#
# 	@nocookie not header Cookie *stg={$STAGING_GATE_SECRET}*
# 	handle @nocookie {
# 		respond "Not found" 404
# 	}
#
# 	handle {
# 		# Grafana serves websockets for live tailing; reverse_proxy upgrades
# 		# them automatically, so no extra configuration is needed here.
# 		reverse_proxy grafana:3000
# 	}
# }
