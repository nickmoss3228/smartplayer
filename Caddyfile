# малако.рф — written in punycode (the A-label form) on purpose.
#
# Caddy accepts Unicode here and converts internally, but every other layer you
# will debug against (Let's Encrypt's issued cert, the browser's Host and Origin
# headers, nginx logs, curl output) shows the punycode form. Keeping the config
# in the same alphabet as the logs saves a lot of confusion.
#
#   малако.рф      -> xn--80aa4acdq.xn--p1ai
#   www.малако.рф  -> www.xn--80aa4acdq.xn--p1ai
#
# ─────────────────────────────────────────────────────────────────────────────
# ONLY list hostnames whose DNS already resolves to THIS VM (89.169.159.92).
#
# Caddy requests a certificate on startup for every name in this file. Let's
# Encrypt validates via an HTTP-01 challenge, which means it fetches
# http://<name>/.well-known/acme-challenge/... — if that name still points
# somewhere else, the challenge lands on the wrong server and fails. Failed
# validations are rate-limited to 5 per hostname per hour, and burning that
# limit delays the real issuance once DNS is correct.
#
# This is why infinityplayer.xyz is NOT listed below: its DNS still points at
# the old Vercel deployment. Add it back only after repointing it here.
# ─────────────────────────────────────────────────────────────────────────────

xn--80aa4acdq.xn--p1ai {
	# Structured access log -> Docker stdout -> Promtail -> Loki. This is the
	# ONLY source of request-level data for the dashboards; Caddy's Prometheus
	# metrics live on the admin API, and exposing that would hand anything on
	# smartplayer-net the ability to rewrite this proxy's config.
	#
	# time_format rfc3339_nano is REQUIRED, not cosmetic. Caddy's default `ts`
	# is a float epoch, which Promtail's timestamp stage cannot parse - every
	# line would silently fall back to ingest time and the latency graphs would
	# bunch up after any restart. Changing this means changing the matching
	# `format: RFC3339Nano` in monitoring/promtail-config.yml.
	log {
		output stdout
		format json {
			time_format rfc3339_nano
		}
	}

	reverse_proxy frontend:80
}

# ─────────────────────────────────────────────────────────────────────────────
# www -> apex, permanent (301).
#
# SPLIT OUT OF THE BLOCK ABOVE 2026-09-05 for SEO. While both names shared one
# site block they both served the app at 200, so every page existed at two
# URLs with nothing to tell a search engine which one counts. That splits
# ranking signals between the duplicates, and there is no canonical link in the
# HTML to break the tie either.
#
# Apex is the canonical form: it is what the manifest, the marketing copy, and
# the Metrica/Webmaster registrations all use.
#
# No new certificate risk here. The cert issued 2026-08-16 already covers both
# apex and www, so this rearranges routing for names Caddy is already serving —
# it does NOT trigger a fresh ACME validation, and none of the rate-limit
# caution at the top of this file applies.
#
# {uri} preserves path AND query string, so https://www.малако.рф/levels/easy
# lands on https://малако.рф/levels/easy rather than the homepage. Redirecting
# every deep link to / would throw away the exact signal this block exists to
# consolidate.
# ─────────────────────────────────────────────────────────────────────────────

www.xn--80aa4acdq.xn--p1ai {
	redir https://xn--80aa4acdq.xn--p1ai{uri} permanent
}

# ─────────────────────────────────────────────────────────────────────────────
# STAGING — test.малако.рф -> test.xn--80aa4acdq.xn--p1ai
#
# ENABLED 2026-08-18, after the A record for test.малако.рф resolved to this VM.
# It was kept commented until then on purpose: Caddy requests a certificate on
# startup for every name here, and five failed HTTP-01 challenges in an hour
# burn the Let's Encrypt rate limit for that name. Comment it back out rather
# than pointing it at a name that has stopped resolving.
#
# DO NOT put basic_auth on this site. It was tried and had to be removed.
#
# HTTP defines exactly one Authorization header. This app authenticates with
# `Authorization: Bearer <jwt>`, so the moment a user logs in, every API call
# overwrites the browser's cached `Authorization: Basic ...`. Caddy then sees a
# Bearer token where it wants basic credentials and returns 401, which the app
# reads as an expired session (logging the user out) while the browser re-opens
# the credential prompt. Verified: 200 with basic credentials, 401 with a
# Bearer token, on the same URL.
#
# The gate below uses a Cookie instead, which no part of the app touches, so
# the collision cannot recur. Everything without the cookie gets a bare 404 —
# not 403 — so the site does not advertise that it exists.
#
# To let a new browser or device in, visit the unlock URL once:
#   https://test.xn--80aa4acdq.xn--p1ai/__unlock/<secret>
# The secret is in the path on purpose: a bare /__unlock would let anyone in.
# The secret is NOT in this file: this repo is public. It comes from
# STAGING_GATE_SECRET in ~/smartplayer/.env on the VM, substituted below as
# {$STAGING_GATE_SECRET}. Note the $: that is Caddyfile-level substitution,
# done as text before the config is parsed. The similar-looking {env.VAR} is a
# RUNTIME placeholder and does NOT work here — path and header matchers are
# compiled at startup, so {env.VAR} stays literal and the gate 404s everyone,
# including anyone holding the right secret. Rotate by changing it
# there and recreating the caddy container (env vars are fixed at container
# start, so a plain `caddy reload` will NOT pick up a new value).
#
# If the variable is unset, docker-compose.yml substitutes an unguessable
# placeholder, so the gate fails CLOSED (404 for everyone) rather than open.
# ─────────────────────────────────────────────────────────────────────────────

test.xn--80aa4acdq.xn--p1ai {
	# Structured access log -> Docker stdout -> Promtail -> Loki. This is the
	# ONLY source of request-level data for the dashboards; Caddy's Prometheus
	# metrics live on the admin API, and exposing that would hand anything on
	# smartplayer-net the ability to rewrite this proxy's config.
	#
	# time_format rfc3339_nano is REQUIRED, not cosmetic. Caddy's default `ts`
	# is a float epoch, which Promtail's timestamp stage cannot parse - every
	# line would silently fall back to ingest time and the latency graphs would
	# bunch up after any restart. Changing this means changing the matching
	# `format: RFC3339Nano` in monitoring/promtail-config.yml.
	log {
		output stdout
		format json {
			time_format rfc3339_nano
		}
	}

	header X-Robots-Tag "noindex, nofollow"

	# One-time unlock: set the gate cookie, then bounce to the app. A year is
	# deliberate — a short cookie means re-unlocking mid-test, and the secret
	# is not protecting anything of value beyond keeping strangers out.
	@unlock path /__unlock/{$STAGING_GATE_SECRET}
	handle @unlock {
		header Set-Cookie "stg={$STAGING_GATE_SECRET}; Max-Age=31536000; Path=/; Secure; HttpOnly; SameSite=Lax"
		# `redir * / 302`, not `redir / 302`. Caddy reads a leading / as an
		# inline path matcher, so the short form means "redirect only the
		# request for exactly / — to a URL literally called 302", which never
		# matches the unlock path and silently returns an empty 200 instead.
		redir * / 302
	}

	# The payment webhook, BEFORE the cookie gate.
	#
	# ЮKassa calls this server-to-server. There is no browser, so there is no
	# cookie, so the gate below would 404 every notification — and ЮKassa
	# retries a failed delivery for 24 hours before giving up. The purchase
	# would still eventually settle (the reconciliation job asks the provider
	# about stale pending payments), but the webhook path would be untestable
	# on staging, which is the whole reason staging exists.
	#
	# `path` is an EXACT match, not a prefix. A prefix here would punch a
	# cookie-gate hole through everything under /api/payments/.
	#
	# Routed through frontend-staging (nginx) rather than straight to
	# backend-staging on purpose: that keeps the chain at exactly the two
	# proxy hops `app.set("trust proxy", 2)` documents, so req.ip is the real
	# client address and the ЮKassa IP allowlist works. Going direct would
	# make it one hop and quietly break the allowlist.
	@yookassa path /api/payments/yookassa/webhook
	handle @yookassa {
		reverse_proxy frontend-staging:80
	}

	# Everything else needs the cookie. Same-origin XHR always sends cookies
	# regardless of SameSite, so the app's API calls pass this untouched.
	@nocookie not header Cookie *stg={$STAGING_GATE_SECRET}*
	handle @nocookie {
		respond "Not found" 404
	}

	handle {
		reverse_proxy frontend-staging:80
	}
}

