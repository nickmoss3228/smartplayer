# Vite build-time vars — baked into the static bundle by `vite build`.
# Not secret: they are visible in the shipped JS via view-source.
VITE_API_URL=https://smartplayer-production.up.railway.app
VITE_YOS_BASE_URL=https://storage.yandexcloud.net/audioplayer-data

# Image name used by docker-compose.
# Leave blank locally -> tags as "smartplayer-frontend:latest".
# On the VM / CI set the full registry path so `docker compose pull` works:
#   FRONTEND_IMAGE=cr.yandex/<registry-id>/smartplayer-frontend
FRONTEND_IMAGE=
TAG=latest
