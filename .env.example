# Vite build-time vars — baked into the static bundle by `vite build`.
# Not secret: they are visible in the shipped JS via view-source.
#
# VITE_API_URL has three meaningful values:
#
#   http://localhost:3000   local dev against your own backend
#   (empty string)          PRODUCTION on the Yandex VM. Relative URLs, so the
#                           browser hits nginx, which proxies /api/ to the
#                           backend container (see nginx.conf). Same-origin, so
#                           CORS never applies and nothing is pinned to a
#                           hostname.
#   https://infinityplayer.xyz  explicit absolute origin — also works, but ties
#                           the bundle to that domain.
#
# The code reads it with `??`, not `||`, so an empty string means "same origin"
# rather than falling back to localhost.
VITE_API_URL=http://localhost:3000
VITE_YOS_BASE_URL=https://storage.yandexcloud.net/audioplayer-data

# Image name used by docker-compose.
# Leave blank locally -> tags as "smartplayer-frontend:latest".
# On the VM / CI set the full registry path so `docker compose pull` works:
#   FRONTEND_IMAGE=cr.yandex/<registry-id>/smartplayer-frontend
FRONTEND_IMAGE=
BACKEND_IMAGE=
TAG=latest
