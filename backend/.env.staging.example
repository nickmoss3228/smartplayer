# Backend environment — STAGING.
#
# Copy to the VM as `backend/.env.staging` (next to package.json, same place
# as .env.production) and fill in. docker-compose.yml's backend-staging
# service reads it via env_file. Never commit the filled-in version.
#
# This file exists to be DIFFERENT from .env.production. Copying production's
# values wholesale defeats the entire point — the four marked CRITICAL below
# are what keep staging from writing to real users' data.

# --- Core (required; the server logs an error at boot if missing) ---
#
# CRITICAL — the database is the whole isolation story, and this is the
# variable the application runs on. Staging has its own database AND
# its own role on the shared `db` server; CONNECT on production's database is
# revoked from everyone but its owner, so a copy-paste mistake fails loudly
# instead of writing into it.
#
#   staging:    postgres://smartplayer_staging:PASS@db:5432/smartplayer_staging
#   production: postgres://smartplayer_prod:PASS@db:5432/smartplayer_prod
DATABASE_URL=
# The self-hosted `db` container speaks plain TCP on the compose network.
PGSSL=disable

# CRITICAL — generate a NEW one, do not reuse production's. Sessions are JWTs
# signed with this; sharing the secret means a token minted by staging
# authenticates against production and vice versa. Any random 32+ byte string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

# The Dockerfile bakes in NODE_ENV=production, and staging runs that same
# image — so without this line staging IS production as far as the code is
# concerned. Compose applies env_file over the image's ENV, which is what lets
# one line here separate them.
#
# Three behaviours are keyed on it: the SMS console provider below, whether a
# payment driver that moves no money may run at all (server.js calls
# assertPaymentsSafeForEnvironment, which refuses one when this says
# "production"), and whether the checkout return page gets its diagnostic
# fields. Setting this to "production" on staging therefore CLOSES THE SHOP
# here, silently and deliberately — that is the guard working, not a bug.
# Express's own NODE_ENV behaviour is not a concern: app.js installs a
# catch-all error handler that returns a fixed JSON body and never a stack.
NODE_ENV=staging

# --- Email (Yandex Cloud Postbox) ---
# Static access key of `smartplayer-postbox-sa` (postbox.sender only). Reusing
# the production key is fine — staging sends far too little to matter — but be
# aware that a password-reset test sends a REAL email to whatever address you
# type. Left blank, staging boots and only password reset fails.
# EMAIL_FROM must be on the Postbox-verified domain:
#   EMAIL_FROM=malako <noreply@xn--80aa4acdq.xn--p1ai>
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=
# Phone verification. Staging runs with NODE_ENV=staging, not production, so
# SMS_PROVIDER=console is available here and is the sane default until the SMS
# Aero account is funded and its sender signature approved: signup on staging
# then works end to end, with the code read from `docker compose logs backend`.
# Switch to smsaero (and fill the two blanks) to rehearse real delivery.
SMS_PROVIDER=console
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=
EMAIL_FROM=

# CRITICAL — reset links are built from this. Left as production's value, a
# reset requested on staging emails a link into the live site.
FRONTEND_URL=https://test.xn--80aa4acdq.xn--p1ai

# --- Admin panel ---
# Use different code words from production. These are what gate the Story
# Builder, the ban button and the audit log; a staging code that also works in
# production removes the separation you just built.
ADMIN_CODE=
# ADMIN_CODES="tester:some-staging-secret"

ADMIN_AUDIT_TTL_DAYS=365

# --- Yandex Object Storage (S3-compatible) ---
#
# CRITICAL — use a SEPARATE BUCKET, not audioplayer-data.
#
# uploadBuffer() in src/helpers/uploadToStorage.js writes deterministic keys
# (`stories/<difficulty>/<storyId>/<part>/audio.mp3`) and overwrites in place
# by design, so re-uploading a corrected clip replaces the old one. Pointed at
# the production bucket, a staging Story Builder upload for an existing story
# therefore OVERWRITES THE LIVE AUDIO — object storage has no profile or
# database boundary to protect it, and the damage is not visible in staging.
#
# Create `audioplayer-data-staging` (Yandex Cloud console -> Object Storage ->
# Create bucket, public read), grant the same service account storage.editor on
# it, and point both variables below at it.
#
# Trade-off to know: a fresh bucket has none of the existing audio, so stories
# imported into staging will 404 on playback until you copy objects over. That
# is the correct trade — read-only 404s in staging beat silently destroying
# production media. To copy: `yc storage s3 sync` or the console's copy tool.
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET=audioplayer-data-staging
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_BASE_URL=https://storage.yandexcloud.net/audioplayer-data-staging

# ── Payments ────────────────────────────────────────────────────────────────
# Staging is where the purchase loop is exercised end to end, so payments are ON
# here while production stays dark.
#
# It runs the FAKE driver: a working payment system with the money removed. The
# full order -> pay -> callback -> settle -> grant loop runs for real, over real
# HTTP, across the real proxy chain — nobody is charged and no money moves.
#
# Three things that are easy to get wrong here, and were:
#
#   1. PUBLIC_API_BASE must be the PUBLIC hostname, not a compose service name.
#      The backend can reach itself internally, but then the callback never
#      crosses Caddy and nginx — and that crossing is the thing staging exists
#      to test.
#   2. The Caddyfile needs the webhook exception. Without one the staging cookie
#      gate 404s every notification, because a callback is server-to-server and
#      carries no browser cookie.
#   3. Recreate the caddy container after changing the Caddyfile
#      (`docker compose up -d --force-recreate caddy`). A plain reload will not
#      pick up {$VAR} substitutions.
#
# When a real acquirer is added, PAYMENTS_PROVIDER changes and its own variables
# join these. Everything below stays exactly as it is: none of it is named after
# a vendor, which is the test of whether the seam is real.
PAYMENTS_ENABLED=true
PAYMENTS_PROVIDER=fake

# Its OWN secret, not production's and not a developer's.
#   openssl rand -hex 32
PAYMENTS_CALLBACK_SECRET=

# Where the driver calls us back. Punycode, because that is what Caddy serves.
PUBLIC_API_BASE=https://test.xn--80aa4acdq.xn--p1ai

# Staging sells the placeholder packs so the loop can be walked before any real
# audio exists. Production must NOT set this.
PURCHASABLE_SKUS=*

