# Backend environment — STAGING.
#
# Copy to the VM as `backend/.env.staging` (next to package.json, same place
# as .env.production) and fill in. docker-compose.yml's backend-staging
# service reads it via env_file. Never commit the filled-in version.
#
# This file exists to be DIFFERENT from .env.production. Copying production's
# values wholesale defeats the entire point — the four marked CRITICAL below
# are what keep staging from writing to real users' data.

# --- Core (required; the server logs an error at boot if missing) ---
#
# CRITICAL — the database name in the path is the whole isolation story.
# Production's URI ends in `.mongodb.net/?retryWrites=...` with NO path, which
# means Mongoose connects to the default database, `test`. That is where every
# real user, progress record, currency balance and Story doc lives right now.
# Putting `/staging` before the query string points this backend at a separate
# database on the same (free) Atlas cluster. Same credentials, same cluster,
# different data — costs nothing extra.
#
#   production: mongodb+srv://USER:PASS@cluster0.mbpdn2e.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
#   staging:    mongodb+srv://USER:PASS@cluster0.mbpdn2e.mongodb.net/staging?retryWrites=true&w=majority&appName=Cluster0
#                                                                    ^^^^^^^
# Getting this wrong is silent: the app works perfectly and quietly writes
# test data into production. Verify after the first boot with
# `docker compose --profile staging logs backend-staging` and by checking that
# the `staging` database appears in the Atlas UI.
MONGODB_URI=

# CRITICAL — generate a NEW one, do not reuse production's. Sessions are JWTs
# signed with this; sharing the secret means a token minted by staging
# authenticates against production and vice versa. Any random 32+ byte string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000

# --- Email (Resend) ---
# The Resend client is constructed at import time, so a missing key crashes the
# process at startup. Reusing the production key is fine — staging sends far
# too little to matter — but be aware that a password-reset test sends a REAL
# email to whatever address you type.
RESEND_API_KEY=
EMAIL_FROM=

# CRITICAL — reset links are built from this. Left as production's value, a
# reset requested on staging emails a link into the live site.
FRONTEND_URL=https://test.xn--80aa4acdq.xn--p1ai

# --- Admin panel ---
# Use different code words from production. These are what gate the Story
# Builder, the ban button and the audit log; a staging code that also works in
# production removes the separation you just built.
ADMIN_CODE=
# ADMIN_CODES="tester:some-staging-secret"

ADMIN_AUDIT_TTL_DAYS=365

# --- Yandex Object Storage (S3-compatible) ---
#
# CRITICAL — use a SEPARATE BUCKET, not audioplayer-data.
#
# uploadBuffer() in src/helpers/uploadToStorage.js writes deterministic keys
# (`stories/<difficulty>/<storyId>/<part>/audio.mp3`) and overwrites in place
# by design, so re-uploading a corrected clip replaces the old one. Pointed at
# the production bucket, a staging Story Builder upload for an existing story
# therefore OVERWRITES THE LIVE AUDIO — object storage has no profile or
# database boundary to protect it, and the damage is not visible in staging.
#
# Create `audioplayer-data-staging` (Yandex Cloud console -> Object Storage ->
# Create bucket, public read), grant the same service account storage.editor on
# it, and point both variables below at it.
#
# Trade-off to know: a fresh bucket has none of the existing audio, so stories
# imported into staging will 404 on playback until you copy objects over. That
# is the correct trade — read-only 404s in staging beat silently destroying
# production media. To copy: `yc storage s3 sync` or the console's copy tool.
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET=audioplayer-data-staging
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_BASE_URL=https://storage.yandexcloud.net/audioplayer-data-staging
