{
  "name": "my-express-server",
  "version": "1.0.0",
  "description": "Express server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "start": "node --import tsx src/server.js",
    "test": "node --import tsx --test \"src/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "etl": "tsx src/scripts/migrateToPostgres.ts",
    "etl:commit": "tsx src/scripts/migrateToPostgres.ts --commit",
    "etl:verify": "tsx src/scripts/migrateToPostgres.ts --verify",
    "test:db": "tsx --test \"src/db/ids.test.ts\" \"src/db/repos/*.test.ts\"",
    "test:integration": "tsx --test \"src/db/integration.test.ts\"",
    "test:api": "node --import tsx --test --test-concurrency=1 \"test/api/*.test.js\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/client-sesv2": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.5.0",
    "nodemon": "^3.1.0",
    "typescript": "~5.7.2"
  }
}
