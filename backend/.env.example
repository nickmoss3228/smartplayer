# Backend environment.
#
# Copy to `backend/.env` for local development. On the Yandex VM the real file
# is `backend/.env.production`, injected by docker-compose via `env_file` —
# see docker-compose.yml. Never commit either.
#
# IMPORTANT: this file must sit at the backend package root (next to
# package.json), NOT in src/. config/env.js resolves it relative to itself so
# the working directory no longer matters, but keeping it here is the
# convention the Docker build and docker-compose both assume.

# --- Core (required; the server logs an error at boot if missing) ---
MONGODB_URI=
JWT_SECRET=
PORT=3000

# --- PostgreSQL (the application's database) ---
#
# REQUIRED: config/env.js refuses to boot without it, and server.js pings the
# database before listening. MONGODB_URI above is now read only by the one-off
# scripts (backupMongo, the content ETL).
#
# Format:  postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
#   local dev   postgres://smartplayer:smartplayer@localhost:5432/smartplayer_dev
#               (docker compose --profile localdb up -d postgres) + PGSSL=disable
#   production  postgres://smartplayer_prod:PASS@db:5432/smartplayer_prod  + PGSSL=disable
#               The `db` service in docker-compose.yml, self-hosted on the VM
#               (pre-launch cost decision — see the comment on that service).
#   staging     postgres://smartplayer_staging:PASS@db:5432/smartplayer_staging + PGSSL=disable
#               Same server, its own database AND role; CONNECT is revoked from
#               PUBLIC, so the staging role cannot open smartplayer_prod at all.
#
# Moving to Yandex Managed PostgreSQL later changes only this URL (host
# c-<cluster-id>.rw.mdb.yandexcloud.net, port 6432) and drops PGSSL=disable.
DATABASE_URL=

# Connections per process. Small on purpose — one backend container plus one
# staging container plus psql plus the ETL all share the cluster's limit.
# PGPOOL_MAX=10

# Set to "disable" for a local Postgres over plain TCP. Managed PostgreSQL
# requires TLS, so leave it unset anywhere real.
# PGSSL=disable

# --- Email (Yandex Cloud Postbox) ---
# Static access key of the `smartplayer-postbox-sa` service account (role:
# postbox.sender only). Blank is fine for local dev — the app boots, and only
# a password-reset request fails (500) at the moment it tries to send.
# EMAIL_FROM (below) must be on a domain verified in Postbox, i.e. малако.рф:
#   EMAIL_FROM=malako <noreply@xn--80aa4acdq.xn--p1ai>
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=

# Phone verification (SMS Aero sends SMS in Russia; keep credentials server-side).
#
# SMS_PROVIDER=console prints the code to the server log instead of sending it,
# which is how you walk signup/login locally without a paid SMS Aero account.
# It is refused when NODE_ENV=production, so it cannot leak codes there.
SMS_PROVIDER=console
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=malako
EMAIL_FROM=

# Used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# --- Admin panel ---
# Single shared code word (legacy). Audit entries are attributed to "admin".
ADMIN_CODE=

# Preferred: per-admin code words, so the audit log can name who did what.
# Overrides ADMIN_CODE when set. This is attribution, not authentication —
# see the comment in src/config/env.js.
# ADMIN_CODES="alice:secret1,bob:secret2"

# How long audit rows are retained before the TTL index expires them.
ADMIN_AUDIT_TTL_DAYS=365

# --- Yandex Object Storage (S3-compatible) ---
# Required for Story Builder audio uploads. Without these,
# POST /api/admin/stories/:id/parts/:n/upload throws and returns 500 with
# "Yandex Object Storage is not configured". The server warns about this at
# boot rather than letting you discover it mid-upload.
#
# To get a key pair: Yandex Cloud console -> Service accounts -> pick/create an
# account with the `storage.editor` role on the bucket -> Create new key ->
# Create static access key. The secret is shown once.
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET=audioplayer-data
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_BASE_URL=https://storage.yandexcloud.net/audioplayer-data

# ── Payments ────────────────────────────────────────────────────────────────
# Absent or not exactly "true" means the shop refuses to CREATE orders. The
# webhook settles anything that arrives regardless: if a notification lands,
# someone paid, and they get what they bought. Taking money and honouring money
# are separate switches.
PAYMENTS_ENABLED=false

# Which driver takes the money. "fake" is a working payment system with the
# money removed: it redirects to its own page, calls back over real HTTP after a
# delay, retries on failure, and can be told to deliver twice, report a wrong
# amount, or lose the notification entirely. That is the whole local loop, with
# no acquirer account anywhere.
#
# Every driver declares whether it can charge anyone, and the server refuses to
# run one that cannot in production — so this cannot be left on by accident.
PAYMENTS_PROVIDER=fake

# Signs the per-payment token planted in every callback URL, which is what
# proves a notification came from someone we handed that URL to. Required
# whenever PAYMENTS_ENABLED=true; without it, orders can be created that could
# never be settled, so the server disables payments rather than allow that.
#
#   openssl rand -hex 32
#
# Different in every environment, and rotate only when nothing is pending —
# in-flight callbacks are signed with the old one.
PAYMENTS_CALLBACK_SECRET=

# Where a driver reaches US. NOT FRONTEND_URL: locally the frontend is :5173
# while the API is :5000, and a callback sent to the wrong one simply 404s.
PUBLIC_API_BASE=http://localhost:5000

# How long the fake acquirer waits before calling back, in milliseconds. Long
# enough that the return page visibly polls — which is the behaviour a real
# acquirer forces on you and the one worth developing against. Set it to 0 if
# the wait becomes tiresome.
# FAKE_CALLBACK_DELAY_MS=2000

# Widens what this environment will sell. The catalog's own `purchasable` flag
# is the PRODUCTION default (the placeholder packs are false until their audio
# exists); this only ever ADDS. "*" opens everything — staging only, NEVER here.
# PURCHASABLE_SKUS=
