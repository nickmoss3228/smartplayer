# Backend environment.
#
# Copy to `backend/.env` for local development. On the Yandex VM the real file
# is `backend/.env.production`, injected by docker-compose via `env_file` —
# see docker-compose.yml. Never commit either.
#
# IMPORTANT: this file must sit at the backend package root (next to
# package.json), NOT in src/. config/env.js resolves it relative to itself so
# the working directory no longer matters, but keeping it here is the
# convention the Docker build and docker-compose both assume.

# --- Core (required; the server logs an error at boot if missing) ---
MONGODB_URI=
JWT_SECRET=
PORT=3000

# --- Email (Resend) ---
# The Resend client is constructed at import time, so a missing key crashes
# the whole process on startup rather than failing at first send.
RESEND_API_KEY=

# Phone verification (SMS Aero sends SMS in Russia; keep credentials server-side).
#
# SMS_PROVIDER=console prints the code to the server log instead of sending it,
# which is how you walk signup/login locally without a paid SMS Aero account.
# It is refused when NODE_ENV=production, so it cannot leak codes there.
SMS_PROVIDER=console
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=malako
EMAIL_FROM=

# Used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# --- Admin panel ---
# Single shared code word (legacy). Audit entries are attributed to "admin".
ADMIN_CODE=

# Preferred: per-admin code words, so the audit log can name who did what.
# Overrides ADMIN_CODE when set. This is attribution, not authentication —
# see the comment in src/config/env.js.
# ADMIN_CODES="alice:secret1,bob:secret2"

# How long audit rows are retained before the TTL index expires them.
ADMIN_AUDIT_TTL_DAYS=365

# --- Yandex Object Storage (S3-compatible) ---
# Required for Story Builder audio uploads. Without these,
# POST /api/admin/stories/:id/parts/:n/upload throws and returns 500 with
# "Yandex Object Storage is not configured". The server warns about this at
# boot rather than letting you discover it mid-upload.
#
# To get a key pair: Yandex Cloud console -> Service accounts -> pick/create an
# account with the `storage.editor` role on the bucket -> Create new key ->
# Create static access key. The secret is shown once.
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_BUCKET=audioplayer-data
YANDEX_ENDPOINT=https://storage.yandexcloud.net
YANDEX_BASE_URL=https://storage.yandexcloud.net/audioplayer-data

# ── Payments (real money) ───────────────────────────────────────────────────
# Absent or not exactly "true" means the shop refuses to CREATE orders. The
# webhook still settles anything that arrives: if a notification lands, someone
# paid, and they get what they bought. Taking money and honouring money are
# separate switches.
PAYMENTS_ENABLED=false

# "mock" runs the whole order -> pay -> webhook -> grant loop with no provider
# account, which is how this is developed locally. "yookassa" is the real one.
PAYMENTS_PROVIDER=mock

# Widens what this environment will sell. The catalog's own `purchasable` flag
# is the PRODUCTION default (the placeholder packs are false until their audio
# exists); this only ever ADDS. "*" opens everything — staging only, NEVER here.
# PURCHASABLE_SKUS=

# From the ЮKassa dashboard. Use the TEST shop's credentials outside production
# — a test shop needs no ИП/ООО and issues no real receipts, so it unblocks all
# the engineering while the legal questions are still open.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# ЮKassa does NOT sign its webhooks — there is no HMAC header to verify. A
# notification is authenticated by source IP plus re-fetching the payment over
# their API. This list is provider-maintained and WILL change; leave it unset to
# use the built-in default in src/config/yookassa.js, and override here when
# they publish new ranges rather than editing that file.
# YOOKASSA_WEBHOOK_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25

# LOCAL DEVELOPMENT ONLY — bypasses the IP allowlist so a webhook can be
# replayed with curl. Refused outright when NODE_ENV=production.
# YOOKASSA_SKIP_IP_CHECK=true
