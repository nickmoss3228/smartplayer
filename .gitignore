.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Private interview-prep study guide — deliberately not published.
INTERVIEW-GUIDE.md

# Not ready to publish yet — remove this line (or git add -f) when it's time
# to make it visible. Only affects untracked files: docs/*.md files already
# committed (yandex-cloud-deployment.md, staging.md, etc.) are unaffected.
docs/

# Grafana admin password, mounted into the container as a file rather than
# passed as an env var (see the note on the grafana service in
# docker-compose.yml). Real value exists only on the VM.
monitoring/grafana_admin_password

# Generated by scripts/build-sitemap.mjs during `npm run build`, from the route
# and story tables in src/. Ignored rather than committed because it is derived
# output: committing it means every story added produces a second, redundant
# diff that can also be forgotten, leaving a sitemap in git that disagrees with
# the one the build emits. Run `npm run sitemap` if you want it locally.
public/sitemap.xml
